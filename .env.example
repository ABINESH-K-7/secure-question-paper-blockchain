# Backend
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/secure_question_papers
# MONGODB_URI is also accepted for compatibility.
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=1h
# Controlled college/demo setting only. Keep false for production.
MFA_DISPLAY_OTP=false
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QUESTION_PAPER_MASTER_KEY=
STORAGE_PROVIDER=local
QUESTION_PAPER_STORAGE_DIR=storage/question-papers
MAX_QUESTION_PAPER_SIZE_MB=10

# Phase 6 S3/KMS mode. Keep STORAGE_PROVIDER=local for local development.
# AWS SDK credentials use the standard provider chain (AWS CLI/profile, environment, or IAM role).
# Never commit real credential values here.
AWS_REGION=
AWS_S3_BUCKET=
AWS_KMS_KEY_ID=
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
FRONTEND_URL=http://localhost:5173
