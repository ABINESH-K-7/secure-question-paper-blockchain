pragma solidity ^0.8.24;
contract QuestionPaperRegistry { struct PaperRecord { bytes32 paperIdHash; bytes32 contentHash; uint256 timestamp; address anchoredBy; bool exists; } mapping(bytes32 => PaperRecord) private papers; mapping(address => bool) public authorizedAnchors; address public immutable owner; event PaperAnchored(bytes32 indexed paperIdHash, bytes32 indexed contentHash, uint256 timestamp, address indexed anchoredBy); error Unauthorized(); error AlreadyAnchored(); constructor() { owner = msg.sender; authorizedAnchors[msg.sender] = true; } function setAuthorizedAnchor(address account, bool allowed) external { if (msg.sender != owner) revert Unauthorized(); authorizedAnchors[account] = allowed; } function anchorPaper(bytes32 paperIdHash, bytes32 contentHash) external { if (!authorizedAnchors[msg.sender]) revert Unauthorized(); if (papers[paperIdHash].exists) revert AlreadyAnchored(); papers[paperIdHash] = PaperRecord(paperIdHash, contentHash, block.timestamp, msg.sender, true); emit PaperAnchored(paperIdHash, contentHash, block.timestamp, msg.sender); } function verifyPaper(bytes32 paperIdHash, bytes32 contentHash) external view returns (bool) { return papers[paperIdHash].exists && papers[paperIdHash].contentHash == contentHash; } function getPaperRecord(bytes32 paperIdHash) external view returns (bytes32,bytes32,uint256,address,bool) { PaperRecord memory p = papers[paperIdHash]; return (p.paperIdHash,p.contentHash,p.timestamp,p.anchoredBy,p.exists); } }
